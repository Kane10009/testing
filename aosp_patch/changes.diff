+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.kane.cameratest">
+
+    <!-- Bind CarSystemUI's CameraAppAreaService (signature permission defined by CarSystemUI). -->
+    <uses-permission android:name="com.android.systemui.car.permission.CONTROL_CAMERA_APP_AREA" />
+    <!-- TYPE_SYSTEM_ALERT camera window, TYPE_SYSTEM_ERROR popup, SYSTEM_FLAG_SHOW_FOR_ALL_USERS. -->
+    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
+    <!-- TYPE_APPLICATION_OVERLAY popup ("popup below"). -->
+    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
+    <!-- Button 4: list root tasks and dump activities. -->
+    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
+    <uses-permission android:name="android.permission.DUMP" />
+    <!-- Button 3: start the test activity for the current (non-system) user. -->
+    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
+    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
+    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
+
+    <!-- persistent: the camera window lives in this process, so it must never be cached,
+         frozen (cached apps freezer -> no input -> ANR -> kill) or killed under memory
+         pressure. Only honored for system apps; runs as the system user only. -->
+    <application
