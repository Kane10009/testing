<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD81B60"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/transparency_title"
        android:textColor="#FFFFFFFF"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/transparency_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/transparency_body"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp" />

    <Button
        android:id="@+id/transparency_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/transparency_close"
        android:textSize="24sp" />
</LinearLayout>
